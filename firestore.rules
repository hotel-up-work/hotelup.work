rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // hotels/{hotelId}.ownerUids maps a Firebase Auth uid to the hotel(s) they own.
    // Created manually (console or an admin script) when an Owner account is provisioned —
    // there is no self-service create/update yet.
    match /hotels/{hotelId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.ownerUids;
      allow write: if false;

      function isHotelOwner() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/hotels/$(hotelId)).data.ownerUids;
      }
      function optText(data, field, max) {
        return !(field in data) || (data[field] is string && data[field].size() <= max);
      }
      function optArea(data) {
        return !('area' in data) || data.area == null || (data.area is number && data.area > 0 && data.area <= 10000);
      }
      function optAmenities(data) {
        return !('amenities' in data) || (data.amenities is list && data.amenities.size() <= 40);
      }
      function isDate(value) {
        return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      // Room inventory (Rooms page). Occupancy will come from bookings; until then status is manual.
      match /rooms/{roomId} {
        function room() { return request.resource.data; }
        function validBlock() {
          return !('block' in room()) || room().block == null
            || (room().block is map
                && room().block.keys().hasOnly(['reason', 'start', 'end', 'note'])
                && room().block.reason is string && room().block.reason.size() <= 50
                && isDate(room().block.start) && isDate(room().block.end)
                && room().block.end >= room().block.start
                && optText(room().block, 'note', 120));
        }

        allow read, delete: if isHotelOwner();
        allow create, update: if isHotelOwner()
          && room().keys().hasAll(['number', 'type', 'floor', 'capacity', 'price', 'status'])
          && room().keys().hasOnly(['number', 'type', 'floor', 'capacity', 'beds', 'area', 'price', 'amenities', 'status',
                                    'block', 'lastCleanedAt', 'createdAt', 'updatedAt'])
          && room().number is string && room().number.size() >= 1 && room().number.size() <= 8
          && room().type is string && room().type.size() >= 1 && room().type.size() <= 50
          && room().floor is int && room().floor >= -5 && room().floor <= 200
          && room().capacity is int && room().capacity >= 1 && room().capacity <= 50
          && room().price is number && room().price >= 0 && room().price <= 1000000
          && room().status in ['ready', 'occupied', 'needs-cleaning', 'cleaning', 'unavailable']
          && optText(room(), 'beds', 100)
          && optArea(room())
          && optAmenities(room())
          && validBlock()
          && (!('lastCleanedAt' in room()) || room().lastCleanedAt == null || room().lastCleanedAt is timestamp)
          && room().updatedAt == request.time;
      }

      // Room types: defaults (capacity, price, beds, amenities) for new rooms of that type.
      match /roomTypes/{typeId} {
        function roomType() { return request.resource.data; }

        allow read, delete: if isHotelOwner();
        allow create, update: if isHotelOwner()
          && roomType().keys().hasAll(['name', 'capacity', 'price'])
          && roomType().keys().hasOnly(['name', 'description', 'capacity', 'beds', 'area', 'price', 'amenities', 'createdAt'])
          && roomType().name is string && roomType().name.size() >= 1 && roomType().name.size() <= 50
          && roomType().capacity is int && roomType().capacity >= 1 && roomType().capacity <= 50
          && roomType().price is number && roomType().price >= 0 && roomType().price <= 1000000
          && optText(roomType(), 'description', 500)
          && optText(roomType(), 'beds', 100)
          && optArea(roomType())
          && optAmenities(roomType());
      }

      // Bookings (Calendar page). Overlap with other bookings and room blocks is checked in the
      // client; rules only validate the shape. Never deleted: a cancelled booking keeps its record.
      match /bookings/{bookingId} {
        function booking() { return request.resource.data; }
        function validBooking() {
          return booking().keys().hasAll(['roomId', 'roomNumber', 'guestName', 'checkIn', 'checkOut', 'guests',
                                          'total', 'paid', 'status', 'createdAt', 'updatedAt'])
            && booking().keys().hasOnly(['roomId', 'roomNumber', 'guestName', 'phone', 'email', 'checkIn', 'checkOut',
                                         'guests', 'total', 'paid', 'status', 'source', 'notes', 'submissionId',
                                         'lateCheckoutHour', 'plannedCheckOut', 'guestId', 'createdAt', 'updatedAt'])
            && booking().roomId is string && booking().roomId.size() >= 1 && booking().roomId.size() <= 40
            && booking().roomNumber is string && booking().roomNumber.size() >= 1 && booking().roomNumber.size() <= 8
            && booking().guestName is string && booking().guestName.size() >= 1 && booking().guestName.size() <= 200
            && isDate(booking().checkIn) && isDate(booking().checkOut)
            && booking().checkOut > booking().checkIn
            && booking().guests is int && booking().guests >= 1 && booking().guests <= 50
            && booking().total is number && booking().total >= 0 && booking().total <= 10000000
            && booking().paid is number && booking().paid >= 0 && booking().paid <= booking().total
            && booking().status in ['pending', 'confirmed', 'checkedin', 'checkedout', 'cancelled']
            && optText(booking(), 'phone', 40)
            && optText(booking(), 'email', 200)
            && optText(booking(), 'source', 50)
            && optText(booking(), 'notes', 1000)
            && optText(booking(), 'submissionId', 40)
            && optText(booking(), 'guestId', 40)
            // Original check-out, kept when an early check-out shortens the stay.
            && (!('plannedCheckOut' in booking()) || (isDate(booking().plannedCheckOut) && booking().plannedCheckOut > booking().checkOut))
            && (!('lateCheckoutHour' in booking()) || booking().lateCheckoutHour == null
                || (booking().lateCheckoutHour is int && booking().lateCheckoutHour >= 12 && booking().lateCheckoutHour <= 23))
            && booking().updatedAt == request.time;
        }

        allow read: if isHotelOwner();
        allow create: if isHotelOwner() && validBooking() && booking().createdAt == request.time;
        allow update: if isHotelOwner() && validBooking() && booking().createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      // Payment journal (Payments page): money received for a booking. Entries are never edited or deleted;
      // a mistake is corrected with another entry. A booking's paid is the running total of its entries (the
      // client adds both in one batch; rules do not cross-check it yet).
      match /payments/{paymentId} {
        function payment() { return request.resource.data; }

        allow read: if isHotelOwner();
        allow create: if isHotelOwner()
          && payment().keys().hasAll(['bookingId', 'guestName', 'roomNumber', 'amount', 'type', 'method', 'occurredOn',
                                      'recordedBy', 'recordedByUid', 'createdAt'])
          && payment().keys().hasOnly(['bookingId', 'guestName', 'roomNumber', 'amount', 'type', 'method', 'note', 'occurredOn',
                                       'recordedBy', 'recordedByUid', 'createdAt'])
          && payment().bookingId is string && payment().bookingId.size() >= 1 && payment().bookingId.size() <= 40
          && payment().guestName is string && payment().guestName.size() >= 1 && payment().guestName.size() <= 200
          && payment().roomNumber is string && payment().roomNumber.size() <= 8
          && payment().amount is number && payment().amount > 0 && payment().amount <= 10000000
          && payment().type == 'payment'
          && payment().method in ['cash', 'card', 'transfer', 'online', 'other']
          && isDate(payment().occurredOn)
          && optText(payment(), 'note', 300)
          && payment().recordedBy is string && payment().recordedBy.size() <= 100
          && payment().recordedByUid is string && payment().recordedByUid.size() <= 40
          && payment().createdAt == request.time;
        allow update, delete: if false;
      }

      // Guests (Guests page): the people who stay. A booking keeps its own copy of the guest's name and
      // contacts and points here with guestId, so deleting or merging a guest never erases booking history.
      // phoneKey is the last 9 digits of the phone ('' when none), nameKey the lower-cased name: both are
      // used to find an existing guest instead of creating a duplicate.
      match /guests/{guestId} {
        function guest() { return request.resource.data; }
        function validGuest() {
          return guest().keys().hasAll(['name', 'nameKey', 'phoneKey', 'createdAt', 'updatedAt'])
            && guest().keys().hasOnly(['name', 'nameKey', 'phone', 'phoneKey', 'email', 'notes', 'tags', 'createdAt', 'updatedAt'])
            && guest().name is string && guest().name.size() >= 1 && guest().name.size() <= 200
            && guest().nameKey is string && guest().nameKey.size() <= 200
            && guest().phoneKey is string && guest().phoneKey.size() <= 9
            && optText(guest(), 'phone', 40)
            && optText(guest(), 'email', 200)
            && optText(guest(), 'notes', 2000)
            && (!('tags' in guest()) || (guest().tags is list && guest().tags.size() <= 20))
            && guest().updatedAt == request.time;
        }

        allow read, delete: if isHotelOwner();
        allow create: if isHotelOwner() && validGuest() && guest().createdAt == request.time;
        allow update: if isHotelOwner() && validGuest() && guest().createdAt == resource.data.createdAt;
      }
    }

    // Public lead-capture forms from the hotel websites. Visitors can only CREATE a submission —
    // never read, update, or delete one. Only the owning hotel's staff can read/update it.
    // Phone is the only required visitor field; formId is a stable slug per form on a site
    // (e.g. "stay-request"), formName its human label shown in the CRM, site the page it was sent
    // from (origin + path) — a hotel may have several websites.
    match /submissions/{submissionId} {
      function data() { return request.resource.data; }
      function optString(field, max) {
        return !(field in data()) || (data()[field] is string && data()[field].size() <= max);
      }
      function optDate(field) {
        return !(field in data()) || (data()[field] is string && data()[field].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }

      allow create: if data().keys().hasAll(['phone', 'formId', 'hotelId', 'status', 'createdAt'])
                    && data().keys().hasOnly(['phone', 'formId', 'formName', 'site', 'hotelId', 'name', 'email', 'message',
                                              'checkIn', 'checkOut', 'guests', 'roomType', 'date', 'time', 'service',
                                              'genders', 'status', 'history', 'createdAt'])
                    && data().phone is string
                    && data().phone.size() >= 5
                    && data().phone.size() <= 40
                    && data().formId is string
                    && data().formId.matches('^[a-z0-9][a-z0-9-]{0,49}$')
                    && data().hotelId is string
                    && exists(/databases/$(database)/documents/hotels/$(data().hotelId))
                    && optString('formName', 100)
                    && (!('site' in data()) || (data().site is string && data().site.size() <= 300
                                                && data().site.matches('^https?://[^#?]+$')))
                    && optString('name', 200)
                    && optString('email', 200)
                    && optString('message', 5000)
                    && optString('roomType', 100)
                    && optDate('checkIn')
                    && optDate('checkOut')
                    // Service requests (sauna, SPA, events…): one date, optional time and option.
                    && optDate('date')
                    && (!('time' in data()) || (data().time is string && data().time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
                    && optString('service', 100)
                    // Hostels: one entry per guest, so dorm beds can be assigned.
                    && (!('genders' in data()) || (data().genders is list && data().genders.size() <= 50
                                                   && data().genders.hasOnly(['female', 'male'])))
                    && (!('guests' in data()) || (data().guests is int && data().guests >= 1 && data().guests <= 300))
                    && (!('history' in data()) || data().history.size() == 0)
                    && data().status == 'new'
                    && data().createdAt == request.time;
      allow read, update: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/hotels/$(resource.data.hotelId)).data.ownerUids;
      allow delete: if false;
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
